{
  "name": "atelier-impulse-storefront",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -k -n FRONTEND,BACKEND \"vite --host 0.0.0.0\" \"npm --prefix backend run dev\"",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "build": "tsc -b && vite build && node scripts/compress-assets.mjs",
    "preview": "vite preview",
    "seo:audit": "node scripts/seo-audit.mjs",
    "check:budgets": "node scripts/performance-budget.mjs",
    "test:seo": "npm --prefix backend run build && node --test backend/dist/backend/tests/seo.test.js",
    "test:security": "npm --prefix backend run build && node --test backend/dist/backend/tests/requestSafety.test.js"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.7.0",
    "@stripe/stripe-js": "^9.9.0",
    "framer-motion": "^12.42.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  }
}
