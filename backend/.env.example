# SQLite schema: use a persistent absolute file path on Render (see render.yaml).
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./vestigia-dev.db
# Local development example:
# DATABASE_PROVIDER=sqlite
# DATABASE_URL=file:./vestigia-dev.db

# ─── SMTP Email ──────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=Vestigia <your-email@gmail.com>

# ─── Stripe ──────────────────────────────────────────────────────────────────────
# Use sk_test_... for test mode, sk_live_... only for production live payments.
STRIPE_SECRET_KEY=sk_test_your_full_test_secret_key
STRIPE_WEBHOOK_SECRET=whsec_...
# Set to true only for local development without Stripe keys.
ALLOW_MOCK_PAYMENTS=false

# ─── JWT ─────────────────────────────────────────────────────────────────────────
JWT_SECRET=generate-a-strong-random-secret-here

# Backup encryption/storage. Keep BACKUP_ENCRYPTION_KEY in your secret manager.
# Do not store this key inside backup archives.
BACKUP_ENCRYPTION_KEY=generate-a-strong-backup-encryption-secret-here
BACKUP_STORAGE_PATH=private/backups
# Optional secondary local/off-site mount path. For production prefer S3-compatible or managed storage.
BACKUP_OFFSITE_PATH=

# ─── CORS ────────────────────────────────────────────────────────────────────────
# Your Netlify frontend URL (e.g. https://vestigia.netlify.app)
FRONTEND_URL=https://your-site.netlify.app

# ─── Port (Railway sets this automatically) ──────────────────────────────────────
PORT=4000

# Single-origin production storefront
SERVE_STOREFRONT=true
PUBLIC_SITE_URL=https://thevestigia.com
# On Render use persistent /var/data paths (see render.yaml).
PUBLIC_SNAPSHOT_PATH=private/published-storefront.json
UPLOAD_DIR=public/uploads

# Set true on staging; leave false on the public production site.
SEO_NOINDEX=false

# Trust only the actual reverse proxy network. Use 1 only behind one trusted hop.
TRUST_PROXY=loopback
