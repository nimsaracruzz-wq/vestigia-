# ─── Database (Railway sets this automatically when you add PostgreSQL plugin) ───
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Local development example:
# DATABASE_PROVIDER=sqlite
# DATABASE_URL=file:./vestigia-dev.db

# ─── SMTP Email ──────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=Vestigia <your-email@gmail.com>

# ─── Stripe ──────────────────────────────────────────────────────────────────────
# Use sk_test_... for test mode, sk_live_... only for production live payments.
STRIPE_SECRET_KEY=sk_test_your_full_test_secret_key
STRIPE_WEBHOOK_SECRET=whsec_...
# Set to true only for local development without Stripe keys.
ALLOW_MOCK_PAYMENTS=false

# ─── JWT ─────────────────────────────────────────────────────────────────────────
JWT_SECRET=generate-a-strong-random-secret-here

# Backup encryption/storage. Keep BACKUP_ENCRYPTION_KEY in your secret manager.
# Do not store this key inside backup archives.
BACKUP_ENCRYPTION_KEY=generate-a-strong-backup-encryption-secret-here
BACKUP_STORAGE_PATH=private/backups
# Optional secondary local/off-site mount path. For production prefer S3-compatible or managed storage.
BACKUP_OFFSITE_PATH=

# ─── CORS ────────────────────────────────────────────────────────────────────────
# Your Netlify frontend URL (e.g. https://vestigia.netlify.app)
FRONTEND_URL=https://your-site.netlify.app

# ─── Port (Railway sets this automatically) ──────────────────────────────────────
PORT=4000
