// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = env("DATABASE_PROVIDER")
  url      = env("DATABASE_URL")
}

model AdminUser {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String // hashed
}

model OrderCounter {
  id    Int @id @default(1)
  year  Int
  count Int @default(0)
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String?  @unique
  category    String
  price       Float
  compareAt   Float?
  badge       String?
  colors      String   // stored as JSON array string
  image       String
  images      String   // stored as JSON array string
  alt         String
  sizes       String   // stored as JSON array string
  description String
  details     String   // stored as JSON array string
  care        String   // stored as JSON array string
  sizeChart   String?  // stored as JSON string
  rating      Float    @default(0)
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  
  reviews     Review[]
  orderItems  OrderItem[]
  inventory   Inventory[]
}

model Inventory {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     String
  size      String
  stock     Int     @default(10)

  @@unique([productId, color, size])
}

model Review {
  id        Int      @id @default(autoincrement())
  author    String
  rating    Int
  date      String
  comment   String
  status    String   @default("approved") // pending, approved, spam
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id                    String      @id // e.g. VST-2026-0001
  invoiceNumber         String?     // e.g. INV-2026-0001
  customer              String
  email                 String
  phone                 String?
  date                  String
  status                String      @default("pending")
  subtotal              Float
  shipping              Float
  tax                   Float
  total                 Float
  address               String
  notes                 String?     // Internal admin notes
  trackingNumber        String?
  courier               String?
  stripePaymentIntentId String?

  shippingRegion        String?
  shippingCountry       String?
  shippingMethod        String?
  shippingCost          Float?
  estimatedDelivery     String?

  customerType          String      @default("GUEST") // "REGISTERED" | "GUEST" | "AUTO_CREATED"
  billingAddress        String?     // JSON string
  sameAsShipping        Boolean     @default(true)
  giftOrder             Boolean     @default(false)
  giftMessage           String?
  companyName           String?
  vatId                 String?

  items     OrderItem[]
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product @relation(fields: [productId], references: [id])
  productName String
  image       String
  size        String
  color       String
  quantity    Int
  price       Float
}

model Customer {
  id               Int       @id @default(autoincrement())
  name             String
  email            String    @unique
  password         String?   // hashed, nullable for guest checkout & auto-created customers
  phone            String?
  addresses        String?   // stored as JSON array string for backward compatibility
  savedAddresses   Address[]
  orders           Int       @default(0)
  totalSpend       Float     @default(0)
  joined           String
  lastOrder        String?
  lastLogin        String?
  resetToken       String?
  resetTokenExpiry String?
  emailVerified    Boolean   @default(false)
  verificationCode String?

  customerType     String    @default("GUEST") // "REGISTERED" | "GUEST" | "AUTO_CREATED" | "MANUAL"
  activationStatus String    @default("GUEST") // "ACTIVATED" | "PENDING" | "GUEST"
  marketingConsent Boolean   @default(false)
  companyName      String?
  vatId            String?
}

model Address {
  id                Int       @id @default(autoincrement())
  customerId        Int?
  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label             String    @default("Home") // "Home", "Office", "Parents", "Warehouse"
  firstName         String
  lastName          String
  company           String?
  address           String
  apartment         String?
  city              String
  state             String
  zip               String
  country           String
  phone             String?
  phoneCountry      String?
  phoneDialCode     String?
  isDefaultShipping Boolean   @default(false)
  isDefaultBilling  Boolean   @default(false)
  createdAt         DateTime  @default(now())
}

model ActivationToken {
  id         Int      @id @default(autoincrement())
  customerId Int
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model PasswordResetToken {
  id         Int      @id @default(autoincrement())
  customerId Int
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model PromoCode {
  id       Int     @id @default(autoincrement())
  code     String  @unique
  discount Float
  type     String  // "percentage" | "fixed"
  uses     Int     @default(0)
  maxUses  Int?
  active   Boolean @default(true)
  expiry   String?
}

model StoreSettings {
  id                  Int     @id @default(1)
  storeName           String
  tagline             String
  currency            String
  announcementText    String
  announcementEnabled Boolean
  shippingThreshold   Float
  complimentaryShippingEnabled Boolean @default(true)
  taxRate             Float
  adminPassword       String // fallback for testing
}

model JournalArticle {
  id       Int      @id @default(autoincrement())
  title    String
  date     String
  readTime String
  excerpt  String
  content  String   // JSON array
  image    String
}

model NewsletterSubscriber {
  id        Int    @id @default(autoincrement())
  email     String @unique
  createdAt String // ISO date string
}

model ShippingRegion {
  id        Int               @id @default(autoincrement())
  name      String            @unique
  isActive  Boolean           @default(true)
  countries ShippingCountry[]
  methods   ShippingMethod[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model ShippingCountry {
  id           Int            @id @default(autoincrement())
  regionId     Int
  region       ShippingRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)
  countryCode  String         @unique // e.g. "US", "LK", "JP"
  countryName  String
  isEnabled    Boolean        @default(true)
  currency     String         @default("USD")
  displayOrder Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model ShippingMethod {
  id                    Int            @id @default(autoincrement())
  regionId              Int
  region                ShippingRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)
  name                  String         // e.g. "Standard Shipping", "Express DHL"
  description           String?
  price                 Float
  estimatedDays         String         // e.g. "3-5 Days"
  freeShippingThreshold Float?         // e.g. 300.0 or null
  isActive              Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

model ShippingAnnouncement {
  id          Int      @id @default(autoincrement())
  countryCode String?  // Specific country code or null for global
  message     String   // e.g. "No shipping to Canada until August 25."
  isSuspended Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model ShippingLog {
  id        Int      @id @default(autoincrement())
  action    String
  details   String
  createdAt DateTime @default(now())
}
